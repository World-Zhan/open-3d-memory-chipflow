current_design direction_fixture
###############################################################################
# Timing Constraints
###############################################################################
create_clock -name sys -period 10.0000 [get_ports {clk}]
set_clock_transition 0.2000 [get_clocks {sys}]
set_input_delay 1.0000 -clock [get_clocks {sys}] -add_delay [get_ports {d}]
set_output_delay 1.0000 -clock [get_clocks {sys}] -add_delay [get_ports {q}]
###############################################################################
# Environment
###############################################################################
set_load -pin_load 0.0100 [get_ports {q}]
set_case_analysis 1 [get_ports {r}]
