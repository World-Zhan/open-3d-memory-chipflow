VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN pad_io_access ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 82240 255000 ) ;
COMPONENTS 2 ;
- XIO sg13g2_IOPadIn + FIXED ( 1000 74000 ) N ;
- XBOND bondpad70_m2_ring + FIXED ( 6000 0 ) N ;
END COMPONENTS
NETS 1 ;
- PAD ( XIO pad ) ( XBOND pad ) + USE SIGNAL ;
END NETS
END DESIGN
