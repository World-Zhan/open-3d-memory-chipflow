diff --git a/scripts_openroad/hbt_capacity_contract.tcl b/scripts_openroad/hbt_capacity_contract.tcl
new file mode 100644
index 0000000..f95a7db
--- /dev/null
+++ b/scripts_openroad/hbt_capacity_contract.tcl
@@ -0,0 +1,255 @@
+# SPDX-License-Identifier: BSD-3-Clause
+#
+# Shared, fail-closed HBT capacity contract for the OpenROAD 3D stages.
+# Geometry comes from the technology database loaded from the selected
+# TECH_LEF.  The pure sizing procedures intentionally remain usable by tclsh
+# fixtures without loading OpenROAD.
+
+namespace eval ::pin3d::hbt {
+  variable schema_version "1.0.0"
+}
+
+proc ::pin3d::hbt::_require_positive {name value} {
+  set number [expr {double($value)}]
+  if {$number <= 0.0} {
+    error "$name must be > 0, got $value"
+  }
+  return $number
+}
+
+proc ::pin3d::hbt::_require_utilization {value} {
+  set utilization [expr {double($value)}]
+  if {$utilization <= 0.0 || $utilization > 1.0} {
+    error "HBT capacity utilization must be in (0,1], got $value"
+  }
+  return $utilization
+}
+
+proc ::pin3d::hbt::_layer_value_dbu {layer odb_command object_method field_name} {
+  if {[llength [info commands $odb_command]]} {
+    if {![catch {$odb_command $layer} value] && $value > 0} {
+      return $value
+    }
+  }
+  if {![catch {$layer $object_method} value] && $value > 0} {
+    return $value
+  }
+  error "cannot read positive $field_name from HBT layer"
+}
+
+proc ::pin3d::hbt::rule_from_db {layer_name} {
+  if {![llength [info commands ::ord::get_db]]} {
+    error "rule_from_db requires an OpenROAD database"
+  }
+  set db [::ord::get_db]
+  if {$db eq "" || $db eq "NULL"} {
+    error "OpenROAD database is not loaded"
+  }
+  set tech [::odb::dbDatabase_getTech $db]
+  if {$tech eq "" || $tech eq "NULL"} {
+    error "OpenROAD technology database is not loaded"
+  }
+  set layer [::odb::dbTech_findLayer $tech $layer_name]
+  if {$layer eq "" || $layer eq "NULL"} {
+    error "HBT cut layer '$layer_name' is absent from the selected TECH_LEF"
+  }
+  set dbu [::odb::dbTech_getDbUnitsPerMicron $tech]
+  if {$dbu <= 0} {
+    error "invalid database units per micron: $dbu"
+  }
+  set width_dbu [::_pin3d_hbt_layer_value_dbu $layer width]
+  set spacing_dbu [::_pin3d_hbt_layer_value_dbu $layer spacing]
+  set width_um [expr {double($width_dbu) / double($dbu)}]
+  set spacing_um [expr {double($spacing_dbu) / double($dbu)}]
+  return [dict create \
+    layer $layer_name \
+    cut_width_um $width_um \
+    cut_height_um $width_um \
+    minimum_edge_spacing_um $spacing_um \
+    legal_pitch_x_um [expr {$width_um + $spacing_um}] \
+    legal_pitch_y_um [expr {$width_um + $spacing_um}]]
+}
+
+proc ::pin3d::hbt::rule_from_lef {path layer_name} {
+  if {![file exists $path]} {
+    error "HBT TECH_LEF is missing: $path"
+  }
+  set fh [open $path r]
+  set in_target 0
+  set width ""
+  set spacing ""
+  while {[gets $fh line] >= 0} {
+    if {!$in_target && [regexp {^\s*LAYER\s+(\S+)} $line -> candidate]} {
+      if {$candidate eq $layer_name} {
+        set in_target 1
+      }
+      continue
+    }
+    if {!$in_target} {
+      continue
+    }
+    if {[regexp {^\s*WIDTH\s+([0-9.+-Ee]+)\s*;} $line -> value]} {
+      set width [expr {double($value)}]
+      continue
+    }
+    if {[regexp {^\s*SPACING\s+([0-9.+-Ee]+)\s*;} $line -> value]} {
+      set spacing [expr {double($value)}]
+      continue
+    }
+    if {[regexp {^\s*END\s+(\S+)} $line -> candidate] && $candidate eq $layer_name} {
+      break
+    }
+  }
+  close $fh
+  if {$width eq "" || $spacing eq "" || $width <= 0.0 || $spacing < 0.0} {
+    error "cannot derive positive WIDTH and non-negative SPACING for '$layer_name' from $path"
+  }
+  return [dict create \
+    layer $layer_name \
+    cut_width_um $width \
+    cut_height_um $width \
+    minimum_edge_spacing_um $spacing \
+    legal_pitch_x_um [expr {$width + $spacing}] \
+    legal_pitch_y_um [expr {$width + $spacing}]]
+}
+
+# Keep the OpenDB command dispatch out of expr/catch substitutions above.  A
+# global shim also avoids namespace command resolution differences across the
+# pinned OpenROAD Tcl builds.
+proc ::_pin3d_hbt_layer_value_dbu {layer field} {
+  if {$field eq "width"} {
+    return [::pin3d::hbt::_layer_value_dbu $layer ::odb::dbTechLayer_getWidth getWidth width]
+  }
+  if {$field eq "spacing"} {
+    return [::pin3d::hbt::_layer_value_dbu $layer ::odb::dbTechLayer_getSpacing getSpacing spacing]
+  }
+  error "unsupported HBT layer field: $field"
+}
+
+proc ::pin3d::hbt::axis_capacity {span_um cut_um pitch_um} {
+  set span [expr {double($span_um)}]
+  set cut [::_pin3d_hbt_require_positive cut $cut_um]
+  set pitch [::_pin3d_hbt_require_positive pitch $pitch_um]
+  if {$span + 1.0e-12 < $cut} {
+    return 0
+  }
+  return [expr {int(floor((($span - $cut) / $pitch) + 1.0e-12)) + 1}]
+}
+
+proc ::_pin3d_hbt_require_positive {name value} {
+  return [::pin3d::hbt::_require_positive $name $value]
+}
+
+proc ::pin3d::hbt::grid_capacity {width_um height_um cut_width_um cut_height_um spacing_um} {
+  set cut_w [::_pin3d_hbt_require_positive cut_width $cut_width_um]
+  set cut_h [::_pin3d_hbt_require_positive cut_height $cut_height_um]
+  set spacing [expr {double($spacing_um)}]
+  if {$spacing < 0.0} {
+    error "minimum edge spacing must be >= 0, got $spacing_um"
+  }
+  set pitch_x [expr {$cut_w + $spacing}]
+  set pitch_y [expr {$cut_h + $spacing}]
+  set nx [axis_capacity $width_um $cut_w $pitch_x]
+  set ny [axis_capacity $height_um $cut_h $pitch_y]
+  return [dict create \
+    width_um [expr {double($width_um)}] \
+    height_um [expr {double($height_um)}] \
+    pitch_x_um $pitch_x \
+    pitch_y_um $pitch_y \
+    sites_x $nx \
+    sites_y $ny \
+    total_sites [expr {$nx * $ny}]]
+}
+
+proc ::pin3d::hbt::required_core_wh {demand utilization aspect_ratio cut_width_um cut_height_um spacing_um} {
+  set count [expr {int($demand)}]
+  if {$count < 0} {
+    error "HBT demand must be >= 0, got $demand"
+  }
+  set util [_require_utilization $utilization]
+  set aspect [::_pin3d_hbt_require_positive aspect_ratio $aspect_ratio]
+  set cut_w [::_pin3d_hbt_require_positive cut_width $cut_width_um]
+  set cut_h [::_pin3d_hbt_require_positive cut_height $cut_height_um]
+  set spacing [expr {double($spacing_um)}]
+  if {$spacing < 0.0} {
+    error "minimum edge spacing must be >= 0, got $spacing_um"
+  }
+  if {$count == 0} {
+    return [dict create \
+      demand 0 utilization $util required_sites 0 \
+      width_um 0.0 height_um 0.0 area_um2 0.0 \
+      pitch_x_um [expr {$cut_w + $spacing}] \
+      pitch_y_um [expr {$cut_h + $spacing}] \
+      sites_x 0 sites_y 0 total_sites 0]
+  }
+
+  set pitch_x [expr {$cut_w + $spacing}]
+  set pitch_y [expr {$cut_h + $spacing}]
+  set required_sites [expr {int(ceil((double($count) / $util) - 1.0e-12))}]
+  set area_bound [expr {(double($count) * $pitch_x * $pitch_y) / $util}]
+  set width_from_area [expr {sqrt($area_bound / $aspect)}]
+  set best ""
+
+  for {set nx 1} {$nx <= $required_sites} {incr nx} {
+    set ny [expr {int(ceil(double($required_sites) / double($nx)))}]
+    set min_w [expr {$cut_w + double($nx - 1) * $pitch_x}]
+    set min_h [expr {$cut_h + double($ny - 1) * $pitch_y}]
+    set width [expr {max($width_from_area, $min_w, $min_h / $aspect)}]
+    set height [expr {$width * $aspect}]
+    set area [expr {$width * $height}]
+    set capacity [grid_capacity $width $height $cut_w $cut_h $spacing]
+    if {[dict get $capacity total_sites] < $required_sites} {
+      continue
+    }
+    if {$best eq "" || $area < [dict get $best area_um2]} {
+      set best [dict merge $capacity [dict create \
+        demand $count \
+        utilization $util \
+        required_sites $required_sites \
+        area_um2 $area]]
+    }
+  }
+  if {$best eq ""} {
+    error "cannot construct an HBT grid for demand=$count utilization=$util"
+  }
+  return $best
+}
+
+proc ::pin3d::hbt::write_contract {path contract} {
+  set parent [file dirname $path]
+  if {![file isdirectory $parent]} {
+    file mkdir $parent
+  }
+  set fh [open $path w]
+  puts $fh $contract
+  close $fh
+}
+
+proc ::pin3d::hbt::read_contract {path} {
+  if {![file exists $path]} {
+    error "missing HBT capacity contract: $path"
+  }
+  set fh [open $path r]
+  set payload [string trim [read $fh]]
+  close $fh
+  if {$payload eq "" || ([llength $payload] % 2) != 0} {
+    error "malformed HBT capacity contract: $path"
+  }
+  return [dict create {*}$payload]
+}
+
+proc ::pin3d::hbt::assert_rule_matches {contract rule {tol 1.0e-12}} {
+  foreach key {cut_width_um cut_height_um minimum_edge_spacing_um legal_pitch_x_um legal_pitch_y_um} {
+    if {![dict exists $contract $key] || ![dict exists $rule $key]} {
+      error "HBT contract/rule is missing '$key'"
+    }
+    set delta [expr {abs(double([dict get $contract $key]) - double([dict get $rule $key]))}]
+    if {$delta > $tol} {
+      error "HBT contract '$key' does not match selected TECH_LEF: contract=[dict get $contract $key] tech=[dict get $rule $key]"
+    }
+  }
+  if {[dict get $contract layer] ne [dict get $rule layer]} {
+    error "HBT contract layer does not match selected TECH_LEF"
+  }
+  return 1
+}
